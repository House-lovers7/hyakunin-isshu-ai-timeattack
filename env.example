# このファイルをコピーして .env.local を作成する:
#   cp env.example .env.local
# 実キーは絶対にコミットしないこと（.gitignore の .env* で除外済み）。
# 変数は src/lib/env.ts（Zod）で検証される。未設定でも mock / replay モードで起動できる。

# === TypeSafe AI (Jev) — 任意。LIVE_MODE=true のローカル実行時のみ必要 ===
# 取得先: https://typesafe.ai （鍵はサーバ側のみで使い、ブラウザへ渡さない）
# TYPESAFE_API_KEY=

# === Jev 実呼び出しの許可（既定 false）。公開サイト（Vercel）では常に false ===
LIVE_MODE=false

# === 1 experiment あたりの費用上限 USD（超過は error.kind="budget_exhausted" → 判定 E） ===
BUDGET_MAX_COST_USD=5

# === App: 絶対 URL 生成に使う ===
APP_URL=http://localhost:3000
