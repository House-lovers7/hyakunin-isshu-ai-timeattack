# このファイルをコピーして .env.local を作成してください:
#   cp env.example .env.local
# Vercel 本番環境では `vercel env` CLI で管理します。
# 実キーは絶対にコミットしないこと。

# === Supabase (必須) ===
# Project Settings > API の値
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバ専用キー。クライアントに絶対に出さない (NEXT_PUBLIC_ プレフィックス禁止)
# SUPABASE_SERVICE_ROLE_KEY=

# === Database (必須) ===
# Drizzle から直接 Postgres へ接続するプール URL (Supabase Transaction pooler: 6543)
DATABASE_URL=postgres://postgres.xxxxx:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# === Vercel AI Gateway (任意) — 未設定なら AI 機能は disabled 扱い ===
# https://vercel.com/docs/ai-gateway で発行
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=anthropic/claude-haiku-4.5

# === Stripe (任意 — 決済を使う場合のみ。使わない場合はコメントアウトのまま) ===
# sk_ / whsec_ / pk_ プレフィックスを lib/env.ts で検証する (test/live 取り違え検知)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# === Cron 内部認証 (任意 — /api/cron/* を作る場合。32 文字以上のランダム文字列) ===
# CRON_SECRET=

# === App ===
# 絶対 URL 生成に使う。本番は https://example.com 等
APP_URL=http://localhost:3000
